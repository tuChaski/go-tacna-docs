@startuml
left to right direction
skinparam packageStyle rectangle

actor "Pasajero" as pasajero
actor "Pasajero_Premium" as pasajero_premium

rectangle "Sistema_Capaqnan_-_Modulo_de_Planificacion_y_Premium" {

    ' RF-14, RF-15, RF-16: Planificación de viaje
    usecase "CU-13:_Consultar_y_Comparar_Alternativas_de_Viaje\n(RF-14,_RF-15,_RF-16)" as CU_PlanificarViaje
    
    ' RF-17: Visualización ampliada
    usecase "CU-14:_Visualizar_Mas_de_2_Micros_Simultaneamente\n(RF-17)" as CU_VerMasMicros
    
    ' RF-18: Aforo del micro
    usecase "CU-15:_Consultar_Nivel_de_Ocupacion_del_Micro\n(RF-18)" as CU_ConsultarAforo
    
    ' RF-19: Alertas de proximidad
    usecase "CU-16:_Recibir_Alertas_de_Micro_Proximo\n(RF-19)" as CU_Alertas
    
    ' RF-20: Favoritos ampliados
    usecase "CU-17:_Guardar_Multiples_Rutas_y_Paraderos_Favoritos\n(RF-20)" as CU_Favoritos
    
    ' RF-21, RF-22, RF-23, RF-24: Funciones avanzadas Premium
    usecase "CU-18:_Acceder_a_Historial_y_Prediccion_Avanzada\n(RF-21,_RF-22,_RF-23,_RF-24)" as CU_FuncionesAvanzadas
    
    ' RF-25: Sin publicidad
    usecase "CU-19:_Navegar_Sin_Publicidad\n(RF-25)" as CU_SinPublicidad
}

' Herencia de actor: El Pasajero Premium tiene todos los permisos del Pasajero estándar
pasajero_premium --|> pasajero

' Acceso Pasajero Estándar
pasajero -- CU_PlanificarViaje

' Acceso Pasajero Premium (Funcionalidades exclusivas)
pasajero_premium -- CU_VerMasMicros
pasajero_premium -- CU_ConsultarAforo
pasajero_premium -- CU_Alertas
pasajero_premium -- CU_Favoritos
pasajero_premium -- CU_FuncionesAvanzadas
pasajero_premium -- CU_SinPublicidad

@enduml