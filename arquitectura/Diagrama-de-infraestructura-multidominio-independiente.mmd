graph TD
    %% CLIENTES Y DOMINIOS
    subgraph Internet [Clientes en Internet]
        D1[Dominio Go-Tacna<br/>www.go-tacna.site]
        D1R[Dominio raíz<br/>go-tacna.site]
        D2[Dominio de otro proyecto<br/>proyecto-b.midominio.com]
    end

    %% VPS CONTABO
    subgraph VPS [VPS de Contabo - 13.140.174.64]
        NginxHost[Nginx global del host<br/>Puertos públicos 80 y 443<br/>TLS Let's Encrypt y enrutamiento por dominio]

        %% PROYECTO GO-TACNA
        subgraph GoTacna [Proyecto go-tacna - Docker Compose]
            NginxCompose[Nginx de Compose<br/>127.0.0.1:8001:80]
            Web[Frontend<br/>web pública y panel]
            Gateway[Gateway Laravel<br/>:8000]
            Backend[Backend Core Laravel<br/>:8000]
            Realtime[Location Service<br/>WebSocket :3001]
            DB[(PostgreSQL 16 + PostGIS)]
        end

        %% OTRO PROYECTO INDEPENDIENTE
        subgraph ProyectoB [Proyecto B - Compose y red independientes]
            GatewayB[Nginx del proyecto B<br/>127.0.0.1:8002:80]
            ServiciosB[Servicios privados del proyecto B]
        end
    end

    D1 -->|HTTPS 443| NginxHost
    D1R -->|301 a www| NginxHost
    D2 -->|HTTPS 443| NginxHost
    NginxHost -->|www.go-tacna.site<br/>proxy_pass 127.0.0.1:8001| NginxCompose
    NginxHost -->|proyecto-b.midominio.com| GatewayB

    NginxCompose -->|/| Web
    NginxCompose -->|/api/| Gateway
    NginxCompose -->|/socket.io/| Realtime
    Gateway -->|HTTP interno| Backend
    Backend --> DB
    GatewayB --> ServiciosB

    style NginxHost fill:#009639,stroke:#fff,stroke-width:2px,color:#fff
    style NginxCompose fill:#2196F3,stroke:#fff,stroke-width:1.5px,color:#fff
    style GoTacna fill:#1f2937,stroke:#2196F3,stroke-width:1.5px,color:#fff
    style ProyectoB fill:#1f2937,stroke:#9ca3af,stroke-width:1px,color:#fff
